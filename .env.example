# Copy to .env and fill in real values. NEVER commit .env. Share keys via Signal/iMessage.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
TAVILY_API_KEY=
THRAD_API_KEY=
OVERMIND_API_KEY=
# Console-only; the Python SDK ignores this.
OVERMIND_PROJECT_ID=
OVERMIND_SERVICE_NAME=sentinel-gate
OVERMIND_ENVIRONMENT=development
ALPIC_TOKEN=
THRAD_API_URL=

# ed25519 signing key for attestations (generate locally; the keys/ dir is gitignored)
ATTESTATION_PRIVATE_KEY_PATH=./keys/attest_ed25519
# Hosted deploys (Alpic): paste the PEM contents here as a secret instead of a file path.
# Generate with: python -c "from sentinel.attest import write_private_key; write_private_key('keys/attest_ed25519')" then paste keys/attest_ed25519
ATTESTATION_PRIVATE_KEY_PEM=

# Context gate: auto = use Thrad DistilBERT when deps/cache are available, otherwise heuristic fallback.
CONTEXT_CLASSIFIER_BACKEND=auto
CONTEXT_CLASSIFIER_BLOCK_CONFIDENCE=0.60
CONTEXT_CLASSIFIER_REVIEW_CONFIDENCE=0.45
CONTEXT_CLASSIFIER_LOCAL_FILES_ONLY=false
THRAD_CONTEXT_MODEL_ID=Thrad/thrad-distilbert-conversation-classifier
THRAD_CONTEXT_MODEL_REVISION=9e7eeadcf69c3f9d286729bb8b6a4f88f7e4faa2
THRAD_CONTEXT_TOKENIZER_ID=distilbert-base-uncased

PORT=8000
ENV=development
